# The Qualys API base URL for your subscription.
# Find yours by logging into Qualys and going to Help > About.
# Format: https://qualysapi.<pod>.apps.qualys.com
SOURCE_QUALYS_BASE_URL=
SOURCE_QUALYS_USERNAME=
SOURCE_QUALYS_PASSWORD=

# The target subscription you want to write tags to.
# Use a different account/POD from the source.
TARGET_QUALYS_BASE_URL=
TARGET_QUALYS_USERNAME=
TARGET_QUALYS_PASSWORD=
